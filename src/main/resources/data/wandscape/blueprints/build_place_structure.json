{
  "id": "build:place_structure",
  "display_name": "Build Structure",
  "description": "Iterate over building pattern offsets, placing each block from block_mapping. Emits build_complete event when done.",
  "params": {
    "offsets": "list<pos>",
    "blocks": "map<string,string>",
    "blocks_nbt": "map<string,string>",
    "entities": "list<map<string,string>>",
    "name": "string",
    "anchor": "pos",
    "material_list": "list<string>",
    "material_counts": "map<string,string>"
  },
  "steps": [
    {
      "type": "request_resource",
      "items": {"map_to_items": {
        "list": "$material_list",
        "as": "mat",
        "resource": "$mat",
        "amount": {"get": ["$material_counts", "$mat"]}
      }}
    },
    {
      "type": "for_each",
      "list": "$offsets",
      "var": "off",
      "steps": [
        {
          "type": "place",
          "at": {"+": ["$anchor", "$off"]},
          "block": {"get": ["$blocks", {"keyof": "$off"}]},
          "nbt": {"get": ["$blocks_nbt", {"keyof": "$off"}]}
        }
      ]
    },
    {
      "type": "for_each",
      "list": "$entities",
      "var": "ent",
      "steps": [
        {
          "type": "spawn_entity",
          "at": {"+": ["$anchor", {"get": ["$ent", "offset"]}]},
          "entity_type": {"get": ["$ent", "type"]},
          "facing": {"get": ["$ent", "facing"]},
          "nbt": {"get": ["$ent", "nbt"]}
        }
      ]
    },
    {
      "type": "emit_event",
      "event": "build_complete",
      "data": {
        "building_name": "$name",
        "blocks_placed": {"size": "$offsets"},
        "anchor": "$anchor"
      }
    }
  ]
}
