{
  "id": "terrain:fill_box",
  "display_name": "Fill Box",
  "description": "Fills a 3D box region with the preset block. Tiles are injected as runtime param.",
  "params": {
    "material_list": "list<string>",
    "material_counts": "map<string,string>"
  },
  "steps": [
    {
      "type": "request_resource",
      "items": {"map_to_items": {
        "list": "$material_list",
        "as": "mat",
        "resource": "$mat",
        "amount": {"get": ["$material_counts", "$mat"]}
      }}
    },
    {
      "type": "for_each",
      "list": "$tiles",
      "var": "tile",
      "steps": [
        {
          "type": "place",
          "at": {"get": ["$tile", "pos"]},
          "block": {"get": ["$tile", "block"]}
        }
      ]
    },
    {
      "type": "emit_event",
      "event": "terrain_fill_complete",
      "data": {
        "blocks_placed": {"size": "$tiles"}
      }
    }
  ]
}
