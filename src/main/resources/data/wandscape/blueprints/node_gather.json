{
  "id": "node:gather",
  "display_name": "节点采集",
  "description": "NPC stands beside a node building and channels for channel_ticks. On completion, elements are injected directly into the colony warehouse.",
  "params": {
    "anchor": "pos",
    "element": "string",
    "amount": "int",
    "channel_ticks": "int"
  },
  "steps": [
    {
      "type": "log",
      "level": "info",
      "text": {"format": ["[NodeGather] NPC gathering {} x{} at {} ({} ticks)", "$element", "$amount", "$anchor", "$channel_ticks"]}
    },
    {
      "type": "ritual",
      "ritual": "node_gathering",
      "at": "$anchor",
      "channel_ticks": "$channel_ticks",
      "params": {
        "element": "$element",
        "amount": "$amount"
      }
    },
    {
      "type": "log",
      "level": "info",
      "text": {"format": ["[NodeGather] Complete: {} x{} → colony warehouse", "$element", "$amount"]}
    }
  ]
}
