{
  "id": "road:build_segment",
  "display_name": "Road Segment",
  "description": "Places road tiles along a pre-generated path segment. Tiles are injected as runtime param.",
  "params": {
    "segment_id": "string",
    "edge_id": "string",
    "material_list": "list<string>",
    "material_counts": "map<string,string>"
  },
  "steps": [
    {
      "type": "request_resource",
      "items": {"map_to_items": {
        "list": "$material_list",
        "as": "mat",
        "resource": "$mat",
        "amount": {"get": ["$material_counts", "$mat"]}
      }}
    },
    {
      "type": "for_each",
      "list": "$tiles",
      "var": "tile",
      "steps": [
        {
          "type": "place",
          "at": {"get": ["$tile", "pos"]},
          "block": {"get": ["$tile", "block"]}
        }
      ]
    },
    {
      "type": "emit_event",
      "event": "road_segment_complete",
      "data": {
        "segment_id": "$segment_id",
        "edge_id": "$edge_id",
        "tiles_placed": {"size": "$tiles"}
      }
    }
  ]
}
