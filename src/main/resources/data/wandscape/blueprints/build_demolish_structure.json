{
  "id": "build:demolish_structure",
  "display_name": "Demolish Structure",
  "description": "Remove all pattern blocks of a building and emit demolish_complete event.",
  "params": {
    "offsets": "list<pos>",
    "anchor": "pos",
    "building_id": "string"
  },
  "steps": [
    {
      "type": "for_each",
      "list": "$offsets",
      "var": "off",
      "steps": [
        {
          "type": "place",
          "at": {"+": ["$anchor", "$off"]},
          "block": "minecraft:air"
        }
      ]
    },
    {
      "type": "emit_event",
      "event": "demolish_complete",
      "data": {
        "anchor": "$anchor",
        "building_id": "$building_id"
      }
    }
  ]
}
