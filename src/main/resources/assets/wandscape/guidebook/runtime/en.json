{
  "manifest_version": 1,
  "book": "wandscape:guide",
  "landing": {
    "title": "Wandscape Guidebook",
    "text": "Welcome to Wandscape! You place the buildings, your wizards do the work, and tourists walk in along the roads to spend.\n\nNew here? Start with [0. Getting Started](intro_0_guide.md), or pick a chapter from the [overview](index_guide.md)."
  },
  "categories": [
    {
      "id": "playstyle",
      "name": "Gameplay Tracks",
      "desc": "This section shows the mod's general intended route. For the details of a feature, see its own category.",
      "icon": "minecraft:compass",
      "sortnum": 0
    },
    {
      "id": "buildings",
      "name": "Buildings",
      "desc": "Every building type and what each one does. For how to build, see 《0. Getting Started》, 《Management》 and 《Build Mode》.",
      "icon": "minecraft:stone_bricks",
      "sortnum": 10
    },
    {
      "id": "management",
      "name": "Management",
      "desc": "The mod's management system and how to operate it. For individual buildings, see 《Buildings》.",
      "icon": "minecraft:lever",
      "sortnum": 20
    },
    {
      "id": "magic",
      "name": "Spells",
      "desc": "Mages, casting, and each spell. For wands and magic items, see 《Equipment and Items》.",
      "icon": "wandscape:spell_scroll",
      "sortnum": 30
    },
    {
      "id": "items",
      "name": "Equipment and Items",
      "desc": "The mod's equipment (wands) and its smaller items. For spells such as scrolls, see 《Spells》; for how to craft them, see 《Crafting Station》.",
      "icon": "wandscape:wand",
      "sortnum": 40
    },
    {
      "id": "custom",
      "name": "Customization & Datapacks",
      "desc": "How to customize the mod's own blocks and data packs — buildings, items, spells, crafting recipes and loot — plus the mod's own commands for reading state and rescuing a stuck colony. For the mod's own content, see 《Buildings》, 《Spells》 and 《Equipment and Items》.",
      "icon": "minecraft:structure_block",
      "sortnum": 50
    },
    {
      "id": "compat",
      "name": "Integration & Compatibility",
      "desc": "What this mod does together with other mods. If you run into a compatibility bug, see 《About Us》.",
      "icon": "minecraft:crafting_table",
      "sortnum": 60
    },
    {
      "id": "about",
      "name": "About Us",
      "desc": "Credits, official platforms, and where to send feedback.",
      "icon": "minecraft:name_tag",
      "sortnum": 70
    }
  ],
