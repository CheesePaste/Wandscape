{
  "manifest_version": 1,
  "book": "wandscape:guide",
  "landing": {
    "title": "魔法小镇建设指南",
    "text": "欢迎来到 Wandscape！你放下建筑，法师替你干活，游客沿路入城消费。\n\n第一次玩？先读[0，入门](intro_0_guide.md)，或从[概览](index_guide.md)挑一节。"
  },
  "categories": [
    {
      "id": "playstyle",
      "name": "玩法主线",
      "desc": "这一部分展示了模组的大致官方游玩路线。对于具体内容，见各功能分类。",
      "icon": "minecraft:compass",
      "sortnum": 0
    },
    {
      "id": "buildings",
      "name": "建筑",
      "desc": "这一页展示了模组的所有建筑类型和对应功能。对于如何建造，见《0，入门》《管理》《建造子模式》。",
      "icon": "minecraft:stone_bricks",
      "sortnum": 10
    },
    {
      "id": "management",
      "name": "管理",
      "desc": "这一页展示了模组的管理系统，操作方式。对于具体建筑，见《建筑》。",
      "icon": "minecraft:lever",
      "sortnum": 20
    },
    {
      "id": "magic",
      "name": "魔法",
      "desc": "这一页展示了法师，施法与具体魔法。对于法杖与魔法道具，见《装备与物品》。",
      "icon": "wandscape:spell_scroll",
      "sortnum": 30
    },
    {
      "id": "items",
      "name": "装备与物品",
      "desc": "这一页展示了模组的装备（法杖）与一些物品。对于法术卷轴等法术，见《魔法》，对于如何制作它们，见《合成站》。",
      "icon": "wandscape:wand",
      "sortnum": 40
    },
    {
      "id": "custom",
      "name": "自定义与数据包",
      "desc": "这一页展示了模组建筑、物品、魔法、合成配方与战利品等内容的模组方块和数据包的自定义方式，以及查状态与急救用的模组指令。对于相关的模组本体内容，见《建筑》《魔法》《装备与物品》。",
      "icon": "minecraft:structure_block",
      "sortnum": 50
    },
    {
      "id": "compat",
      "name": "联动与兼容",
      "desc": "这一页展示了模组兼容和联动的其他模组。如果出现了兼容的BUG，见《关于我们》。",
      "icon": "minecraft:crafting_table",
      "sortnum": 60
    },
    {
      "id": "about",
      "name": "关于我们",
      "desc": "制作者名单、官方平台与反馈渠道。",
      "icon": "minecraft:name_tag",
      "sortnum": 70
    }
  ],
